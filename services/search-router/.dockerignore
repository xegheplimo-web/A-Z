# Build context hygiene — keep the image and the context small.
.pytest_cache
.ruff_cache
__pycache__
*.pyc
*.pyo
.venv
venv
.env
.env.*

# Tests/docs/eval run on the host or in CI — never inside the image.
# scripts/ IS shipped: the data-ops compose service runs the staged
# ingest/resolve/index CLIs with `python -m scripts.*` inside this image.
tests/
eval/
docs/
*.md

# Generated artifacts (regenerated per build)
coverage*.json
sbom.cdx.json
data/
