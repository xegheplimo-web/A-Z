# Optional in-process embedding image. The main API image deliberately omits
# the `ml` extra; only this specialist image pays the Torch/model dependency.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /usr/local/bin/uv
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ml
COPY services/ ./services/
COPY config.py .

ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv" \
    EMBEDDING_MODEL=BAAI/bge-m3 \
    EMBEDDING_DEVICE=cpu \
    EMBEDDING_BATCH_SIZE=32 \
    EMBEDDING_PORT=8892 \
    HOST=0.0.0.0 \
    PORT=8892

EXPOSE 8892
HEALTHCHECK --interval=30s --timeout=15s --retries=5 --start-period=60s \
    CMD curl -fsS http://localhost:8892/health || exit 1
CMD ["python", "-m", "services.bge_embedding"]
