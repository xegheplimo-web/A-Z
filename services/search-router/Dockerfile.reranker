# Optional in-process reranker image. The main API image deliberately omits
# the `ml` extra; only this specialist image pays the Torch/model dependency.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.12.18 /uv /usr/local/bin/uv
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra ml
COPY services/ ./services/
COPY config.py .

ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv" \
    RERANKER_MODEL=BAAI/bge-reranker-v2-m3 \
    RERANKER_DEVICE=cpu \
    RERANKER_BATCH_SIZE=16 \
    RERANKER_PORT=8891 \
    HOST=0.0.0.0 \
    PORT=8891

EXPOSE 8891
HEALTHCHECK --interval=30s --timeout=15s --retries=5 --start-period=60s \
    CMD curl -fsS http://localhost:8891/health || exit 1
CMD ["python", "-m", "services.bge_reranker"]
