# --- Database (Postgres) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Retrieval brain: CHỈ MỘT tại runtime ---
#   embedded      (mặc định) engine tham chiếu: dev / offline / fixture benchmark
#   search-router production: gọi POST {SEARCH_ROUTER_URL}/v1/retrieve (Retrieval Contract v1, docs/retrieve.contract.md)
RETRIEVAL_BACKEND=embedded
SEARCH_ROUTER_URL=
SEARCH_ROUTER_API_KEY=
SEARCH_ROUTER_TIMEOUT_MS=30000
# Chỉ khi muốn tạm chuyển sang embedded lúc search-router lỗi (mặc định: KHÔNG, trả 503 rõ ràng)
RETRIEVAL_FALLBACK=

# --- Lane web tuỳ chọn CHỈ cho engine embedded (dev) — KHÔNG dùng khi RETRIEVAL_BACKEND=search-router ---
# Bật lane "search-hub": web · news · gov · legal qua SearXNG/OpenSearch/Qdrant.
# Bỏ trống = chạy bằng canonical places + corpus nội bộ.
SEARCH_HUB_URL=
SEARCH_HUB_API_KEY=

# --- Inference Engine (LLM) — tùy chọn ---
# vietscope-1 = Retrieval Engine (deterministic) + Inference Engine (LLM thay thế được).
# Chưa cấu hình → synthesizer extractive; retrieval/routing/ranking/verification không đổi.
# Phương án A (khuyến nghị): API ngoài OpenAI-compatible, vd Qwen3.8-Flash-Next
#   LLM_BASE_URL=https://<provider>/v1   LLM_MODEL=qwen3.8-flash-next
# Phương án B (local RTX 3090 24GB): llama-server với model 20–35B quant
#   LLM_BASE_URL=http://127.0.0.1:8080/v1   LLM_MODEL=local
# Phương án C (máy lớn): vLLM/llama.cpp chạy Flash-Next + MTP draft head (mtp-*.gguf chỉ là bộ tăng tốc)
#   LLM_BASE_URL=http://vllm:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Override theo vai trò (trống = dùng LLM_MODEL) — cùng tên biến với search-router
LLM_PLANNER_MODEL=
LLM_SYNTH_MODEL=
LLM_VERIFY_MODEL=
LLM_EXTRACT_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1

# --- Auth / quota (Postgres): key lưu SHA-256, rate limit + quota + usage dùng chung giữa các instance ---
# VIETSCOPE_ADMIN_KEY bật /v1/admin/keys (tạo/liệt kê/thu hồi key). Nên đặt khi lên production.
VIETSCOPE_ADMIN_KEY=
# Bí mật ký MCP session (stateless). Mặc định dẫn xuất từ DATABASE_URL.
MCP_SESSION_SECRET=
# --- (cũ, chỉ để bootstrap) danh sách key tạm trong env ---
# Danh sách key hợp lệ, phân tách bằng dấu phẩy. Bỏ trống = demo mở, không cần Bearer.
VIETSCOPE_API_KEYS=
RATE_LIMIT_PER_MIN=60
# BẬT CHỈ khi facade đứng sau reverse proxy mình kiểm soát và proxy overwrite
# X-Forwarded-For (không forward header nguyên xi của client). Khi tắt, IP rate
# limit gom hết về bucket "anon" — an toàn chống spoof nhưng chung quota.
TRUST_PROXY_HEADERS=false
