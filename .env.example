# --- Database ---
# DEV local OK:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Production PHẢI thay user/password mạnh, không dùng postgres:postgres.

# --- Retrieval brain: CHỈ MỘT tại runtime ---
#   embedded      (mặc định) engine tham chiếu: dev / offline / fixture benchmark
#   search-router production: gọi POST {SEARCH_ROUTER_URL}/v1/retrieve (Retrieval Contract v1, docs/retrieve.contract.md)
RETRIEVAL_BACKEND=embedded
# Production PHẢI là:
#   RETRIEVAL_BACKEND=search-router
#   SEARCH_ROUTER_URL=http://search-router:8888
SEARCH_ROUTER_URL=
SEARCH_ROUTER_API_KEY=
# Hard ceiling cuối cùng — không phải SLA. Mode-level deadline sống trong search core;
# adapter nên áp timeout theo mode (fast < standard < research) khi cần.
SEARCH_ROUTER_TIMEOUT_MS=30000
# Giữ RỖNG: production brain chết → trả 503 rõ ràng, không âm thầm rơi về
# fixture/dev engine. Chỉ đặt khi cố ý chấp nhận degrade.
RETRIEVAL_FALLBACK=

# --- Lane web tuỳ chọn CHỈ cho engine embedded (dev) — KHÔNG dùng khi RETRIEVAL_BACKEND=search-router ---
# Bật lane "search-hub": web · news · gov · legal qua SearXNG/OpenSearch/Qdrant.
# Bỏ trống = chạy bằng canonical places + corpus nội bộ.
SEARCH_HUB_URL=
SEARCH_HUB_API_KEY=

# --- Inference Engine (LLM) — tùy chọn ---
# vietscope-1 = Retrieval Engine (deterministic) + Inference Engine (LLM thay thế được).
# Chưa cấu hình → synthesizer extractive; retrieval/routing/ranking/verification không đổi.
# Phương án A (khuyến nghị): API ngoài OpenAI-compatible, vd Qwen3.8-Flash-Next
#   LLM_BASE_URL=https://<provider>/v1   LLM_MODEL=qwen3.8-flash-next
# Phương án B (local RTX 3090 24GB): llama-server với model 20–35B quant
#   LLM_BASE_URL=http://127.0.0.1:8080/v1   LLM_MODEL=local
# Phương án C (máy lớn): vLLM/llama.cpp chạy Flash-Next + MTP draft head (mtp-*.gguf chỉ là bộ tăng tốc)
#   LLM_BASE_URL=http://vllm:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Override theo vai trò (trống = dùng LLM_MODEL) — cùng tên biến với search-router
LLM_PLANNER_MODEL=
LLM_SYNTH_MODEL=
LLM_VERIFY_MODEL=
LLM_EXTRACT_MODEL=
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1

# --- Auth / quota ---
# VIETSCOPE_ADMIN_KEY: bật /v1/admin/keys (tạo/liệt kê/thu hồi key) VÀ là key
# mở khoá /ops/* qua form /ops/auth (→ session cookie HttpOnly) hoặc Bearer.
# Production nên là strong random (openssl rand -hex 32). KHÔNG đặt → /ops/*
# chỉ mở từ mạng nội bộ (khi TRUST_PROXY_HEADERS=true) — fail-closed.
VIETSCOPE_ADMIN_KEY=
# Bí mật ký MCP session (stateless, chia sẻ giữa các instance). Production
# đặt random ĐỘC LẬP (openssl rand -hex 32) — đừng phụ thuộc derive từ
# DATABASE_URL, vì rotate DB password không nên đổi session.
MCP_SESSION_SECRET=
# (cũ, chỉ để bootstrap) Danh sách API key phân tách dấu phẩy.
# RỖNG = demo mở, không cần Bearer — KHÔNG được để rỗng khi public API
# (production: tạo key trong DB qua /v1/admin/keys rồi để trống env này).
VIETSCOPE_API_KEYS=
RATE_LIMIT_PER_MIN=60
# BẬT CHỈ khi facade đứng sau reverse proxy mình kiểm soát và proxy OVERWRITE
# X-Forwarded-For (không forward header nguyên xi của client — nếu chỉ nối tiếp,
# kẻ ngoài giả IP để bypass rate limit / vào /ops/*). Tắt → rate-limit gom về
# bucket "anon", an toàn nhưng chung quota.
TRUST_PROXY_HEADERS=false
