# Normalize line endings. Quan trọng nhất: *.sh phải LF — entrypoint.sh chạy trong Linux container.
* text=auto

*.sh        text eol=lf
*.bash      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile* text eol=lf

*.ps1       text eol=crlf
*.psm1      text eol=crlf

# Binaries
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.gguf  binary
